<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ErpForFactoryGames.CaptainOfIndustry.Extractor</RootNamespace>
    <!-- Packaging shape is undecided: this is an offline CLI, not a library.
         See ErpForFactoryGames#319 before giving it a PackageId. -->
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Read-only metadata inspection of CoI's net4.x assemblies for diagnostics. -->
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="9.0.0" />
  </ItemGroup>

</Project>
