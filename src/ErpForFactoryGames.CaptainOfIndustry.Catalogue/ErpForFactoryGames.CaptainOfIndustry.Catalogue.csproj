<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!--
      Docs are generated for the package, but requiring a <summary> on every
      positional record member and ToString override is noise, not rigour.
    -->
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>ErpForFactoryGames.CaptainOfIndustry.Catalogue</PackageId>
    <Description>
      Reads Captain of Industry's product, recipe and building catalogue from a
      local game installation, and persists it as JSON for use without one.
    </Description>
    <Authors>ERP for Factory Games</Authors>
    <PackageProjectUrl>https://github.com/erp-for-factory-games/CaptainOfIndustry</PackageProjectUrl>
    <RepositoryUrl>https://github.com/erp-for-factory-games/CaptainOfIndustry</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>captain-of-industry;catalogue;recipes;factory-game;modding</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
